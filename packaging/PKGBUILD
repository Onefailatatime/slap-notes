# Maintainer: FunnelFix <linda@sayhellotolinda.com>

pkgname=slap-notes-bin
_appname=slap-notes
pkgver=0.1.7
pkgrel=1
pkgdesc="Local-first block notes with a wiki-link graph (the Cluster Brain) and a built-in AI research agent"
arch=('x86_64')
url="https://slapnotes.com"
license=('custom:proprietary')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libnotify')
provides=("${_appname}=${pkgver}")
conflicts=("${_appname}")
replaces=("${_appname}")
# Electron ships prebuilt binaries: stripping them breaks the bundle.
options=('!strip' '!debug')
install="${pkgname}.install"
source=("${pkgname}-${pkgver}.tar.zst::https://github.com/Onefailatatime/slap-notes/releases/download/${pkgver}/${_appname}-${pkgver}-linux-x64.tar.zst")
sha256sums=('22b303beaff6d80cb78078850a98bcf9f37eb29d99e37c2b0cd8c2fe4b4e02fb')

package() {
  cd "${srcdir}/${_appname}-${pkgver}"

  install -dm755 "${pkgdir}/opt/${_appname}"
  cp -a app/. "${pkgdir}/opt/${_appname}/"

  # The sandbox helper stays non-SUID here; the install script raises it only
  # on kernels without unprivileged user namespaces.
  chmod 0755 "${pkgdir}/opt/${_appname}/chrome-sandbox"

  install -dm755 "${pkgdir}/usr/bin"
  ln -s "/opt/${_appname}/${_appname}" "${pkgdir}/usr/bin/${_appname}"

  install -Dm644 "${_appname}.desktop" \
    "${pkgdir}/usr/share/applications/${_appname}.desktop"

  local size
  for size in 16 32 48 64 128 256 512 1024; do
    install -Dm644 "icons/${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${_appname}.png"
  done

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
